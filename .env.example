# ============================================================================
# ORBIT Platform — Environment Variables Template
# Copy to .env and fill in your values. Never commit .env to version control.
# ============================================================================

# ── Node Environment ──────────────────────────────────────────────────────────
NODE_ENV=development
# Options: development | staging | production

# ── Database (PostgreSQL) ─────────────────────────────────────────────────────
DATABASE_URL=postgresql://orbit_user:orbit_password@localhost:5432/orbit_db
# Production example: postgresql://user:password@your-db-host:5432/orbit_prod
# Docker local: postgresql://orbit_user:orbit_password@postgres:5432/orbit_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
# Docker: redis://redis:6379
# With password: redis://:password@redis:6379

# ── JWT Secrets ───────────────────────────────────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-prod
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-min-32-chars
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"

# ── Encryption (for sensitive bank/PAN data) ─────────────────────────────────
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-change-in-prod
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# ── SMTP / Gmail OTP ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=orbit.quickcontent@gmail.com
SMTP_PASS=your-gmail-app-password
SMTP_FROM="ORBIT <orbit.quickcontent@gmail.com>"

# ── Cloudflare R2 Storage ─────────────────────────────────────────────────────
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET=orbit-media
R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.orbit-quickcontent.com

# ── Razorpay (Payments) ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ── Cashfree (Payouts) ────────────────────────────────────────────────────────
CASHFREE_CLIENT_ID=your_cashfree_client_id
CASHFREE_CLIENT_SECRET=your_cashfree_client_secret
CASHFREE_API_VERSION=2023-08-01
CASHFREE_ENV=TEST
# Options: TEST | PROD

# ── FCM (Firebase Cloud Messaging) ───────────────────────────────────────────
FCM_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}
# Or point to file: FCM_SERVICE_ACCOUNT_PATH=./fcm-service-account.json

# ── Maps / OSRM ───────────────────────────────────────────────────────────────
OSRM_BASE_URL=https://router.project-osrm.org
# Self-hosted: http://your-osrm-server:5000
# Public OSRM demo (dev only): https://router.project-osrm.org

# ── Server Ports ──────────────────────────────────────────────────────────────
PORT=5000
SOCKET_PORT=3003

# ── Allowed Origins (CORS) ────────────────────────────────────────────────────
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# ── Partner Master Login (Development/Testing ONLY) ───────────────────────────
PARTNER_MASTER_LOGIN_ENABLED=true
# CRITICAL: Set to false in production. Never expose in APK/build.
PARTNER_MASTER_EMAIL=orbit.quickcontent@gmail.com
PARTNER_MASTER_CODE=123456

# ── Sentry (Error Monitoring) ─────────────────────────────────────────────────
SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id

# ── Wallet Config ─────────────────────────────────────────────────────────────
PARTNER_EARNING_AMOUNT=500
# Fixed ₹500 earning per completed booking

# ── Dispatch Config ───────────────────────────────────────────────────────────
DISPATCH_ROUND1_RADIUS_KM=2
DISPATCH_ROUND2_RADIUS_KM=5
DISPATCH_ROUND3_RADIUS_KM=10
DISPATCH_OFFER_TIMEOUT_SECONDS=45

# ── GPS Config ────────────────────────────────────────────────────────────────
GPS_UPDATE_INTERVAL_SECONDS=5
PARTNER_LOCATION_TTL_SECONDS=60

# ── Frontend URLs (for webhooks / redirects) ──────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_SOCKET_URL=ws://localhost:3003
