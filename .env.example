# ============================================================================
# ORBIT MASTER ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# ============================================================================
# Copy this file to `.env` (for local development) or configure these in your
# cloud provider (Vercel, AWS ECS, GCP Cloud Run, Docker, Kubernetes, etc.)
# ============================================================================

# ── Core Server Environment ──────────────────────────────────────────────────
NODE_ENV=production
PORT=5000
ALLOWED_ORIGINS=https://orbit-quickcontent.com,https://dashboard.orbit-quickcontent.com,http://localhost:3000,http://localhost:3001

# ── Web App & Frontend Integrations (Next.js) ────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=your_nextauth_secret_min_32_chars_random_string

# ── Database & In-Memory Cache (PostgreSQL & Valkey / Redis) ─────────────────
# PostgreSQL Connection URL
DATABASE_URL=postgresql://orbit_user:your_strong_password@your-db-host:5432/orbit_prod?schema=public

# Managed Valkey / Redis URL (Use rediss:// for TLS-enabled Valkey / Redis)
VALKEY_URL=rediss://default:your_valkey_password@your-valkey-host.managed-provider.com:6379
REDIS_URL=redis://localhost:6379

# ── Authentication, Cryptography & Encryption ────────────────────────────────
# Minimum 32 character random secrets for JWT signing
JWT_SECRET=your_jwt_secret_min_32_chars_long_and_cryptographically_secure
JWT_REFRESH_SECRET=your_jwt_refresh_secret_min_32_chars_long_and_secure

# 32-character / 32-byte encryption key for sensitive partner bank details (AES-256)
ENCRYPTION_KEY=orbit_bank_secret_enc_key_2026_x

# ── Email Service (SMTP / Transactional OTP) ─────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=your_smtp_api_key_or_password
SMTP_SECURE=false
SMTP_FROM="ORBIT <no-reply@orbit-quickcontent.com>"

# Optional Alternative: Brevo / Gmail OAuth
BREVO_API_KEY=your_brevo_api_key_here
GMAIL_USER=your-email@gmail.com
GMAIL_CLIENT_ID=your_gmail_oauth_client_id
GMAIL_CLIENT_SECRET=your_gmail_oauth_client_secret
GMAIL_REFRESH_TOKEN=your_gmail_oauth_refresh_token

# ── WhatsApp & SMS Notifications (Zavu Gateway) ──────────────────────────────
ZAVU_API_KEY=your_zavu_api_key_here
ZAVU_API_URL=https://api.zavu.dev/v1/messages
ZAVU_SENDER=ORBIT

# ── Firebase Admin & Push Notifications (FCM) ────────────────────────────────
FIREBASE_PROJECT_ID=orbit-17d89
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@orbit-17d89.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"
FIREBASE_STORAGE_BUCKET=orbit-17d89.firebasestorage.app
FCM_SERVICE_ACCOUNT_JSON=

# ── Object Storage (Cloudflare R2 / AWS S3) ──────────────────────────────────
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_BUCKET=orbit-prod-media
S3_ACCESS_KEY_ID=your_r2_access_key_id
S3_SECRET_ACCESS_KEY=your_r2_secret_access_key
S3_REGION=auto

# ── OAuth Social Logins (Google & Apple) ──────────────────────────────────────
GOOGLE_CLIENT_ID=your_google_oauth_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret
APPLE_ID=com.orbit.web
APPLE_TEAM_ID=your_apple_team_id
APPLE_KEY_ID=your_apple_key_id
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_APPLE_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"

# ── Maps, Routing & Geocoding ────────────────────────────────────────────────
OSRM_BASE_URL=https://router.project-osrm.org
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org

# ── Background Queue & Asynchronous Jobs (QStash) ────────────────────────────
QSTASH_TOKEN=your_upstash_qstash_token_here

# ── Dispatch Engine Configuration ────────────────────────────────────────────
DISPATCH_ROUND1_RADIUS_KM=2
DISPATCH_ROUND2_RADIUS_KM=5
DISPATCH_ROUND3_RADIUS_KM=10
DISPATCH_OFFER_TIMEOUT_SECONDS=45
PARTNER_EARNING_AMOUNT=500
PARTNER_LOCATION_TTL_SECONDS=60

# ── Telemetry, Health & Monitoring ───────────────────────────────────────────
ENABLE_METRICS=true
SENTRY_DSN=https://your_sentry_dsn_here

# ── Master / Staging Bypass (Development / QA Testing Only) ───────────────────
PARTNER_MASTER_LOGIN_ENABLED=false
PARTNER_MASTER_EMAIL=partner.test@orbit.app
PARTNER_MASTER_CODE=123456
