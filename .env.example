# ============================================================================
# ORBIT Platform — Environment Variables Template (Managed Deployment)
# Copy to .env and fill in your values. Never commit .env to version control.
# ============================================================================

# ── Node Environment ──────────────────────────────────────────────────────────
NODE_ENV=development
# Options: development | staging | production

# ── Database (Supabase PostgreSQL) ────────────────────────────────────────────
# Use Transaction pooler for DATABASE_URL (port 6543)
DATABASE_URL=postgres://[db-user]:[db-password]@aws-0-[region].pooler.supabase.com:6543/postgres
# Use Session/Direct connection for DIRECT_URL (port 5432) for Prisma Migrations
DIRECT_URL=postgres://[db-user]:[db-password]@aws-0-[region].pooler.supabase.com:5432/postgres

# ── Supabase (Auth, Realtime, Storage) ────────────────────────────────────────
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── JWT Secrets (Preserved from existing auth) ────────────────────────────────
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-change-in-prod
JWT_REFRESH_SECRET=your-super-secret-refresh-jwt-key-min-32-chars

# ── Encryption (for sensitive bank/PAN data) ─────────────────────────────────
ENCRYPTION_KEY=your-32-byte-hex-encryption-key-change-in-prod

# ── Redis / Managed Key-Value (Upstash) ───────────────────────────────────────
REDIS_URL=rediss://default:[password]@[endpoint].upstash.io:[port]

# ── SMTP / Gmail OTP ─────────────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=orbit.quickcontent@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM="ORBIT <orbit.quickcontent@gmail.com>"

# ── Supabase Storage Buckets ──────────────────────────────────────────────────
STORAGE_BUCKET_RAW=orbit-raw-footage
STORAGE_BUCKET_REELS=orbit-reels

# ── Razorpay (Payments) ───────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ── Cashfree (Payouts) ────────────────────────────────────────────────────────
CASHFREE_APP_ID=your_cashfree_app_id
CASHFREE_SECRET_KEY=your_cashfree_secret_key

# ── Maps / OSRM ───────────────────────────────────────────────────────────────
OSRM_BASE_URL=https://router.project-osrm.org
MAP_STYLE_URL=https://basemaps.cartocdn.com/gl/dark-matter-gl-style/style.json
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org

# ── Allowed Origins (CORS) ────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://admin.orbitapp.com,https://editor.orbitapp.com
