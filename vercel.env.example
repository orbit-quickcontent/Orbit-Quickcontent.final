# ============================================================================
# ORBIT VERCEL ENVIRONMENT VARIABLES (PRODUCTION)
# Copy and paste these into your Vercel Project Settings -> Environment Variables
# ============================================================================

# ── 1. Core Serverless Environment ──────────────────────────────────────────
NODE_ENV=production
ALLOWED_ORIGINS=*

# ── 2. Supabase PostgreSQL Database (Prisma) ─────────────────────────────────
# Transaction Pooler connection string (Port 6543)
DATABASE_URL=postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres?pgbouncer=true

# Session / Direct connection string (Port 5432) for migrations
DIRECT_URL=postgres://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:5432/postgres

# ── 3. Supabase Credentials (Storage & Realtime) ────────────────────────────
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]

# ── 4. Supabase Storage Buckets ─────────────────────────────────────────────
STORAGE_BUCKET_RAW=orbit-raw-footage
STORAGE_BUCKET_REELS=orbit-reels

# ── 5. Authentication & Security Secrets ────────────────────────────────────
JWT_SECRET=orbit-super-secure-production-jwt-secret-key-32chars
JWT_REFRESH_SECRET=orbit-super-secure-production-refresh-jwt-secret-key-32chars
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── 6. Upstash Redis (Optional - for high performance rate limiting/caching) ──
REDIS_URL=rediss://default:[YOUR-UPSTASH-PASSWORD]@[YOUR-ENDPOINT].upstash.io:6379

# ── 7. Upstash QStash (Serverless Background Jobs) ──────────────────────────
QSTASH_TOKEN=[YOUR-UPSTASH-QSTASH-TOKEN]

# ── 8. Payment Gateways ─────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_live_[YOUR_KEY_ID]
RAZORPAY_KEY_SECRET=[YOUR_RAZORPAY_SECRET]

CASHFREE_APP_ID=[YOUR_CASHFREE_APP_ID]
CASHFREE_SECRET_KEY=[YOUR_CASHFREE_SECRET_KEY]

# ── 9. Email / OTP (SMTP) ───────────────────────────────────────────────────
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=orbit.quickcontent@gmail.com
SMTP_PASS=[YOUR-GMAIL-APP-PASSWORD]
SMTP_FROM="ORBIT" <orbit.quickcontent@gmail.com>

# ── 10. Maps / Routing ──────────────────────────────────────────────────────
OSRM_BASE_URL=https://router.project-osrm.org
GEOCODING_BASE_URL=https://nominatim.openstreetmap.org
