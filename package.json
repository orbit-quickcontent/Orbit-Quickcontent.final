{
  "name": "orbit-platform",
  "version": "1.0.0",
  "private": true,
  "description": "ORBIT — Hyperlocal Professional Video Marketplace Platform",
  "workspaces": [
    "backend",
    "dashboard-web-app",
    "editor-web-app"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:dashboard\" \"npm run dev:editor\"",
    "dev:backend": "cd backend && npm run dev",
    "dev:dashboard": "cd dashboard-web-app && npm run dev",
    "dev:editor": "cd editor-web-app && npm run dev",
    "dev:all": "npm run dev",
    "build": "npm run build:backend && npm run build:dashboard && npm run build:editor",
    "build:backend": "cd backend && npm run build",
    "build:dashboard": "cd dashboard-web-app && npm run build",
    "build:editor": "cd editor-web-app && npm run build",
    "lint": "npm run lint:backend && npm run lint:dashboard && npm run lint:editor",
    "lint:backend": "cd backend && npm run lint",
    "lint:dashboard": "cd dashboard-web-app && npm run lint",
    "lint:editor": "cd editor-web-app && npm run lint",
    "type-check": "npm run type-check:backend && npm run type-check:dashboard && npm run type-check:editor",
    "type-check:backend": "cd backend && npx tsc --noEmit",
    "type-check:dashboard": "cd dashboard-web-app && npm run type-check",
    "type-check:editor": "cd editor-web-app && npm run type-check",
    "test": "npm run test:backend",
    "test:backend": "cd backend && npm test",
    "db:generate": "cd backend && npx prisma generate",
    "db:migrate": "cd backend && npx prisma migrate deploy",
    "db:migrate:dev": "cd backend && npx prisma migrate dev",
    "db:studio": "cd backend && npx prisma studio",
    "db:seed": "cd backend && npm run seed",
    "docker:build": "docker-compose build",
    "docker:up": "docker-compose up -d",
    "docker:down": "docker-compose down",
    "docker:logs": "docker-compose logs -f",
    "docker:staging": "docker-compose -f docker-compose.staging.yml up -d"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
