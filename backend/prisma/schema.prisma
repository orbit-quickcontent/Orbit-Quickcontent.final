// ============================================================================
// ORBIT Platform — Prisma Schema (PostgreSQL v3.0)
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ── Enums ─────────────────────────────────────────────────────────────────────

enum UserRole {
  CLIENT
  PARTNER
  EDITOR
  ADMIN
  SUPER_ADMIN
}

enum PartnerStatus {
  REGISTERED
  PROFILE_INCOMPLETE
  VERIFICATION_PENDING
  CODE_REQUIRED
  ACTIVE
  SUSPENDED
  REJECTED
}

enum PartnerVerificationStatus {
  UNVERIFIED
  PENDING
  CODE_REQUIRED
  VERIFIED
  REJECTED
}

enum VerificationCodeStatus {
  ACTIVE
  USED
  EXPIRED
  REVOKED
}

enum BookingStatus {
  PENDING_PAYMENT
  PAYMENT_PROCESSING
  PAID
  DISPATCHING
  PARTNER_OFFERED
  PARTNER_ASSIGNED
  EN_ROUTE
  ARRIVED
  SHOOTING
  UPLOADING
  SYNCED
  EDITOR_AVAILABLE
  EDITOR_ASSIGNED
  EDITING
  QUALITY_CHECK
  REVISION_REQUESTED
  DELIVERED
  PAYOUT_PENDING
  PAYOUT_PROCESSING
  PAYOUT_COMPLETED
  NO_PARTNER_AVAILABLE
  CANCELLED
  FAILED
}

enum PaymentStatus {
  UNPAID
  PROCESSING
  SUCCESS
  FAILED
  REFUNDED
}

enum DispatchStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  CANCELLED
}

enum TransactionType {
  EARNING
  WITHDRAWAL
  REFUND
  BONUS
  PLATFORM_FEE
  TDS_DEDUCTION
  WITHDRAWAL_REVERSAL
}

enum TransactionStatus {
  PENDING
  COMPLETED
  FAILED
  REVERSED
}

enum WithdrawalStatus {
  REQUESTED
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}

enum KycStatus {
  NOT_STARTED
  PENDING
  PROCESSING
  VERIFIED
  FAILED
  RETRY_REQUIRED
  REJECTED
}

enum MediaAssetType {
  RAW_FOOTAGE
  FINAL_REEL
  THUMBNAIL
  PROFILE_PHOTO
}

enum NotificationChannel {
  FCM
  IN_APP
  EMAIL
  SMS
}

// ── Models ────────────────────────────────────────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  phone        String?
  role         UserRole  @default(CLIENT)
  avatar       String?
  passwordHash String?
  twoFactorSecret String?
  twoFactorEnabled Boolean @default(false)
  isActive     Boolean   @default(true)
  fcmToken     String?   // Firebase Cloud Messaging device token
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  deletedAt    DateTime?

  bookings     Booking[]
  partner      Partner?
  editor       Editor?
  otps         EmailOTP[]
  notifications Notification[]
  auditLogs    AuditLog[]

  @@index([role])
  @@index([email])
  @@map("users")
}

model Partner {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  // Profile
  displayName    String?
  phone          String?
  profilePhoto   String?
  address        String?
  city           String?
  state          String?
  pincode        String?
  experienceYears Int?
  equipment      String? // JSON array of equipment
  bio            String?

  // Status & Availability
  status            PartnerStatus            @default(REGISTERED)
  verificationStatus PartnerVerificationStatus @default(UNVERIFIED)
  isOnline          Boolean                  @default(false)
  isAvailable       Boolean                  @default(false)
  canAcceptBookings Boolean                  @default(false)

  // Location (updated live)
  latitude   Float?
  longitude  Float?
  lastSeenAt DateTime?

  // Ratings
  rating            Float @default(0.0)
  completedProjects Int   @default(0)

  // Device
  fcmToken   String?
  deviceInfo String?

  // KYC
  panNumber         String?
  panVerificationStatus KycStatus @default(NOT_STARTED)
  aadhaarLast4      String?

  // Bank Account (encrypted)
  bankAccountId String?
  bankAccount   BankAccount? @relation(fields: [bankAccountId], references: [id])

  // Wallet (denormalized for fast reads)
  walletId String?   @unique
  wallet   PartnerWallet? @relation("PartnerWallet")

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  bookings        Booking[]
  workDispatches  WorkDispatch[]
  transactions    WalletTransaction[]
  withdrawals     Withdrawal[]
  verificationCodes PartnerVerificationCode[]

  @@index([status])
  @@index([isOnline, isAvailable, status])
  @@index([userId])
  @@map("partners")
}

model PartnerVerificationCode {
  id            String                 @id @default(cuid())
  code          String                 // Plain code for admin display (ORBIT-XXXXXX)
  codeHash      String                 @unique // bcrypt hash stored, never plain in prod
  partnerId     String?
  partner       Partner?               @relation(fields: [partnerId], references: [id])
  partnerEmail  String
  trainerName   String
  trainingDate  DateTime
  status        VerificationCodeStatus @default(ACTIVE)
  expiresAt     DateTime
  usedAt        DateTime?
  createdBy     String                 // Admin user ID
  revokedBy     String?
  revokedAt     DateTime?
  revocationReason String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt

  @@index([partnerEmail])
  @@index([status])
  @@index([codeHash])
  @@map("partner_verification_codes")
}

model Package {
  id           String   @id @default(cuid())
  name         String
  tier         String   @unique
  price        Int      // Price in paise (INR * 100) for Razorpay
  priceDisplay Int      // Price in INR for display (1999, 4999)
  partnerPayout Int     @default(500) // ₹500 partner earning
  focus        String
  deliveryTime String
  features     Json     // Array of feature strings
  popular      Boolean  @default(false)
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  bookings Booking[]

  @@map("packages")
}

model Booking {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id])
  packageId String
  package   Package @relation(fields: [packageId], references: [id])
  partnerId String?
  partner   Partner? @relation(fields: [partnerId], references: [id])
  editorId  String?
  editor    Editor?  @relation(fields: [editorId], references: [id])

  // Status
  status        BookingStatus @default(PENDING_PAYMENT)
  paymentStatus PaymentStatus @default(UNPAID)

  // Payment
  paymentId     String?
  paymentOrderId String?
  paymentMethod String?
  amountPaid    Int?    // in paise

  // Location
  latitude    Float?
  longitude   Float?
  address     String?

  // Schedule
  bookingDate DateTime
  timeSlot    String

  // Media
  footageUrls  Json?    // Array of R2 URLs
  masterReelUrl String?
  hlsUrl        String?

  // Dispatch tracking
  dispatchRound Int     @default(0)
  declinedBy    Json    @default("[]") // Array of partner IDs

  // Timestamps
  partnerAssignedAt DateTime?
  arrivedAt         DateTime?
  shootingStartedAt DateTime?
  shootingEndedAt   DateTime?
  uploadStartedAt   DateTime?
  uploadCompletedAt DateTime?
  editorAssignedAt  DateTime?
  editingStartedAt  DateTime?
  deliveredAt       DateTime?
  cancelledAt       DateTime?
  cancelledBy       String?   // CLIENT | PARTNER | ADMIN
  cancellationReason String?
  cancellationFee   Int?      // in paise

  notes      String?
  syncPercentage Int @default(0)

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  workDispatches     WorkDispatch[]
  statusHistory      BookingStatusHistory[]
  payments           Payment[]
  mediaAssets        MediaAsset[]
  editorAssignments  EditorAssignment[]
  notifications      Notification[]

  @@index([userId])
  @@index([partnerId])
  @@index([editorId])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("bookings")
}

model BookingStatusHistory {
  id        String        @id @default(cuid())
  bookingId String
  booking   Booking       @relation(fields: [bookingId], references: [id])
  fromStatus BookingStatus?
  toStatus  BookingStatus
  changedBy String?       // userId or system
  reason    String?
  metadata  Json?
  createdAt DateTime      @default(now())

  @@index([bookingId])
  @@index([createdAt])
  @@map("booking_status_history")
}

model WorkDispatch {
  id        String        @id @default(cuid())
  bookingId String
  booking   Booking       @relation(fields: [bookingId], references: [id])
  partnerId String
  partner   Partner       @relation(fields: [partnerId], references: [id])

  status      DispatchStatus @default(PENDING)
  round       Int            @default(1)
  offerExpiresAt DateTime
  respondedAt  DateTime?
  distanceKm   Float?
  etaMinutes   Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([partnerId])
  @@index([status])
  @@index([bookingId, status])
  @@map("work_dispatches")
}

model Editor {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id])

  displayName String?
  isActive    Boolean @default(true)
  fcmToken    String?

  currentJobId String?
  totalDelivered Int @default(0)
  rating         Float @default(0.0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings     Booking[]
  assignments  EditorAssignment[]

  @@map("editors")
}

model EditorAssignment {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id])
  editorId  String
  editor    Editor  @relation(fields: [editorId], references: [id])

  claimedAt   DateTime @default(now())
  startedAt   DateTime?
  deliveredAt DateTime?
  deadline    DateTime?

  @@unique([bookingId, editorId])
  @@index([bookingId])
  @@index([editorId])
  @@map("editor_assignments")
}

model Payment {
  id            String        @id @default(cuid())
  bookingId     String
  booking       Booking       @relation(fields: [bookingId], references: [id])
  razorpayOrderId String?     @unique
  razorpayPaymentId String?   @unique
  amount        Int           // in paise
  currency      String        @default("INR")
  status        PaymentStatus @default(UNPAID)
  webhookData   Json?
  processedAt   DateTime?
  idempotencyKey String       @unique

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([razorpayOrderId])
  @@index([status])
  @@map("payments")
}

model MediaAsset {
  id        String         @id @default(cuid())
  bookingId String
  booking   Booking        @relation(fields: [bookingId], references: [id])
  type      MediaAssetType
  url       String         // R2 URL
  key       String         // R2 object key
  mimeType  String?
  sizeBytes BigInt?
  duration  Int?           // seconds
  isVerified Boolean       @default(false)
  verifiedAt DateTime?
  uploadedBy String?       // partnerId or editorId

  createdAt DateTime @default(now())

  @@index([bookingId])
  @@index([type])
  @@map("media_assets")
}

model PartnerWallet {
  id            String  @id @default(cuid())
  partnerId     String  @unique
  partner       Partner @relation("PartnerWallet", fields: [partnerId], references: [id])

  available     Int     @default(0) // in paise
  reserved      Int     @default(0) // reserved for pending withdrawals
  totalEarned   Int     @default(0)
  totalWithdrawn Int    @default(0)

  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]
  withdrawals  Withdrawal[]

  @@map("partner_wallets")
}

model WalletTransaction {
  id              String            @id @default(cuid())
  partnerId       String
  partner         Partner           @relation(fields: [partnerId], references: [id])
  walletId        String
  wallet          PartnerWallet     @relation(fields: [walletId], references: [id])
  bookingId       String?
  withdrawalId    String?
  type            TransactionType
  amount          Int               // in paise (positive = credit, negative = debit)
  balanceAfter    Int               // snapshot of balance after transaction
  status          TransactionStatus @default(COMPLETED)
  description     String?
  idempotencyKey  String            @unique
  referenceId     String?

  createdAt DateTime @default(now())

  @@index([partnerId])
  @@index([walletId])
  @@index([bookingId])
  @@index([idempotencyKey])
  @@index([createdAt])
  @@map("wallet_transactions")
}

model Withdrawal {
  id           String           @id @default(cuid())
  partnerId    String
  partner      Partner          @relation(fields: [partnerId], references: [id])
  walletId     String
  wallet       PartnerWallet    @relation(fields: [walletId], references: [id])
  bankAccountId String
  bankAccount  BankAccount      @relation(fields: [bankAccountId], references: [id])

  amount         Int              // in paise
  status         WithdrawalStatus @default(REQUESTED)
  cashfreeTransferId String?
  cashfreeStatus    String?
  webhookData       Json?
  failureReason     String?
  idempotencyKey    String         @unique

  requestedAt  DateTime @default(now())
  processedAt  DateTime?
  completedAt  DateTime?
  failedAt     DateTime?

  @@index([partnerId])
  @@index([status])
  @@index([idempotencyKey])
  @@map("withdrawals")
}

model BankAccount {
  id            String    @id @default(cuid())
  partnerId     String
  accountHolderName     String
  encryptedAccountNumber String  // AES-256 encrypted
  ifscCode      String
  bankName      String?
  branchName    String?
  accountType   String    @default("SAVINGS")

  // Verification
  verificationStatus KycStatus @default(NOT_STARTED)
  pennyDropRef  String?
  verifiedAt    DateTime?
  failureReason String?

  isDefault     Boolean   @default(true)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  partner     Partner[]
  withdrawals Withdrawal[]

  @@index([partnerId])
  @@map("bank_accounts")
}

model EmailOTP {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  email      String
  otpHash    String   // bcrypt hash of the 6-digit OTP
  expiresAt  DateTime
  attempts   Int      @default(0)
  maxAttempts Int     @default(5)
  isUsed     Boolean  @default(false)
  usedAt     DateTime?
  ipAddress  String?

  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([email])
  @@index([expiresAt])
  @@map("email_otps")
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id])
  bookingId String?
  booking   Booking?            @relation(fields: [bookingId], references: [id])
  channel   NotificationChannel @default(IN_APP)
  title     String
  body      String
  data      Json?
  isRead    Boolean             @default(false)
  readAt    DateTime?
  sentAt    DateTime?
  fcmMessageId String?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])
  action    String   // e.g. "PARTNER_CODE_GENERATED", "BOOKING_STATUS_CHANGED"
  entity    String   // e.g. "PartnerVerificationCode", "Booking"
  entityId  String?
  details   Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
