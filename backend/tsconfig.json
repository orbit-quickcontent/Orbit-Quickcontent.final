{
  "compilerOptions": {
    "target": "es2022",
    "module": "commonjs",
    "lib": ["es2022"],
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "moduleResolution": "node",
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": [
    "node_modules",
    "dist",
    "src/client/**/*",
    "src/partner/**/*",
    "src/shared/**/*",
    "src/lib/auth-server.ts",
    "src/lib/db.ts",
    "src/lib/firebase.ts",
    "src/services/audit.service.ts",
    "src/services/db.service.ts",
    "src/services/firebase.ts",
    "src/services/firestore-db.ts",
    "src/test_direct.ts",
    "src/**/route.ts"
  ]
}
