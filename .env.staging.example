# ============================================================================
# ORBIT Staging Environment Variables (.env.staging)
# ============================================================================

NODE_ENV=staging
PORT=5000
ALLOWED_ORIGINS=https://staging.orbit-quickcontent.com,http://localhost:3000,http://localhost:3001

# ── Database & Redis ──────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:staging_password@staging-db.orbit-quickcontent.com:5432/orbit_staging?schema=public
REDIS_URL=redis://staging-redis.orbit-quickcontent.com:6379

# ── JWT Secrets ───────────────────────────────────────────────────────────────
JWT_SECRET=orbit_staging_jwt_secret_11223344556677889900aabbccddeeff
JWT_REFRESH_SECRET=orbit_staging_refresh_secret_11223344556677889900aabbccddeeff
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# ── Firebase Cloud Services ───────────────────────────────────────────────────
FIREBASE_PROJECT_ID=orbit-17d89
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-fbsvc@orbit-17d89.iam.gserviceaccount.com
FIREBASE_STORAGE_BUCKET=orbit-17d89.firebasestorage.app
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvAIBADANBgkqhkiG9w0BAQEFAASCBKYwggSiAgEAAoIBAQDOkqbPKkrwLQcS\n-----END PRIVATE KEY-----\n"

# ── Test Payment Gateways (Sandbox) ──────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_5kQp1J8mN9vL2A
RAZORPAY_KEY_SECRET=rzp_test_secret_placeholder
CASHFREE_APP_ID=TEST1029384756
